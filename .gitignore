# ==========================================
# ADM Platform Monorepo - Git Ignore File
# ==========================================

# 1. Node.js / React (Vite) / Express Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# 2. Legacy Python rules (kept as safety net — no Python backends remain)
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.env_python/
pip-log.txt
pip-delete-this-directory.txt

# 3. Environment Variables
# ALWAYS ignore .env files to prevent leaking secrets. 
# Create a .env.example file for version control instead.
.env
.env.*
!.env.example

# 4. Databases (SQLite)
# Ignore all local database files in the shared database/ folder
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-journal
*.db

# 5. Frontend Build Folders (Vite)
dist/
build/
out/

# 6. Uploads & Storage (User Content)
# Ignore user-uploaded files, but keep the directories if needed
storage/
**/uploads/
*.pdf
*.jpg
*.jpeg
*.png
# Allow icons and logos in public/ folders (needed for UI)
!**/public/**/*.png
!**/public/logo.png
!**/public/icons/*.png
*.csv

# 7. Logs (Generated by start_all.sh)
logs/
*.log
pids.txt
nohup.out

# 8. OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 9. IDE / Agent Files
.gemini/
