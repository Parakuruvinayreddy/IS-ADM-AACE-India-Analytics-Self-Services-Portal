# =============================================================================
# ADM Analytics Platform - Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual production/staging values.
# =============================================================================

# Server settings
HOST=0.0.0.0
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# PostgreSQL Database Connection Settings
# -----------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?options=-c%20search_path%3D[schema]
# Example for AWS RDS:
# DB_URL=postgresql://dbadmin:MySecurePassword123@ss-dev-rds-is-adm-india-db.c123456789.us-east-1.rds.amazonaws.com:5432/postgres?options=-c%20search_path%3Dis_adm_india
DB_URL=postgresql://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_DB_HOST_OR_RDS_ENDPOINT:5432/YOUR_DATABASE_NAME?options=-c%20search_path%3Dis_adm_india

# Token Encryption (used for encrypting tokens in transit)
TOKEN_ENCRYPTION_KEY=7650676dd6c496bd2bda396802e7bdaeac921c40dd1714938236b7dad975c1f4

# -----------------------------------------------------------------------------
# AWS S3 Storage Configuration (for documents and image uploads)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_FOLDER_PREFIX=CDD

# AWS IAM Credentials (Leave blank if running on EC2 with an IAM Instance Profile role)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Routing & Service URLs
# -----------------------------------------------------------------------------
ADMIN_BACKEND_URL=http://localhost:3001
INTAKE_BASE_URL=http://localhost:5175/intake
